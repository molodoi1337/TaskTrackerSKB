@startuml Flowchart_TaskListFilter
title Блок-схема алгоритма TaskListViewModel.tasks\n(фильтрация и сортировка списка задач)

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ActivityBackgroundColor #EAF4FF
skinparam ActivityBorderColor #2A6FBF
skinparam ActivityDiamondBackgroundColor #FFF3D6
skinparam ActivityDiamondBorderColor #B07A00
skinparam ArrowColor #333333
skinparam defaultFontName Sans

start

:Получить (all, f):\nall — все задачи,\nf — фильтры/сортировка;
:result := all;

if (f.query не пуст?) then (да)
  :q := lowercase(trim(f.query));
  :result := отфильтровать по\ntitle.contains(q) OR\ndescription.contains(q);
else (нет)
endif

if (f.statusFilter задан?) then (да)
  :result := отфильтровать по\nstatus == f.statusFilter;
else (нет)
endif

if (f.projectFilter задан?) then (да)
  :result := отфильтровать по\nprojectId == f.projectFilter;
else (нет)
endif

switch (f.sortBy?)
case (CREATED)
  :result := sortByDescending(createdAt);
case (DEADLINE)
  :result := sortBy(deadline ?: MAX_VALUE);
case (STATUS)
  :result := sortBy(status.ordinal);
endswitch

:вернуть result\n(emit в StateFlow);

stop

@enduml
